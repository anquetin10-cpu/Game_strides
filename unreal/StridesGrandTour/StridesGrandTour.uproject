{
	"FileVersion": 3,
	"EngineAssociation": "5.8",
	"Category": "Game",
	"Description": "Equestrian Tour (STRIDES) — portage natif du jeu web, iPhone/iPad en priorité.",
	"Modules": [
		{ "Name": "StridesGrandTour", "Type": "Runtime", "LoadingPhase": "Default" },
		{ "Name": "StridesCore", "Type": "Runtime", "LoadingPhase": "PreDefault" }
